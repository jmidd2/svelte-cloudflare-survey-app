{
  "name": "anon-feedback-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "yarn run build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "yarn tsx --env-file=.env ./db/seed.ts",
    "deploy": "yarn run build && wrangler deploy --outdir dist --upload-source-maps --var SENTRY_RELEASE:$(sentry-cli releases propose-version)",
    "deploy:version": "yarn run build && wrangler versions upload --outdir dist --upload-source-maps --var SENTRY_RELEASE:$(sentry-cli releases propose-version)",
    "cf-typegen": "wrangler types && mv worker-configuration.d.ts src/",
    "auth:schema": "npx @better-auth/cli@latest generate --output src/lib/server/db/auth-schema.ts",
    "sentry:sourcemaps": "_SENTRY_RELEASE=$(sentry-cli releases propose-version) && sentry-cli releases new $_SENTRY_RELEASE --org=jmidd-dev --project=feedback-app && sentry-cli sourcemaps upload --org=jmidd-dev --project=feedback-app --release=$_SENTRY_RELEASE --strip-prefix 'dist/..' dist",
    "postdeploy": "yarn sentry:sourcemaps",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@cloudflare/workers-types": "^4.20250724.0",
    "@floating-ui/core": "^1.7.2",
    "@floating-ui/dom": "^1.7.2",
    "@internationalized/date": "^3.8.2",
    "@lucide/svelte": "^0.525.0",
    "@playwright/test": "^1.54.1",
    "@sentry/cli": "^2.50.2",
    "@sveltejs/adapter-auto": "^6.0.1",
    "@sveltejs/adapter-cloudflare": "^7.1.1",
    "@sveltejs/kit": "^2.25.2",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/table-core": "^8.21.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "@types/d3": "^7.4.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^22.16.5",
    "@vitest/coverage-v8": "^3.2.4",
    "better-call": "^1.0.12",
    "bits-ui": "^2.8.11",
    "chalk": "^5.4.1",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "drizzle-kit": "^0.31.4",
    "drizzle-seed": "^0.3.1",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "^2.0.1",
    "jsdom": "^26.1.0",
    "layerchart": "2.0.0-next.33",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.0",
    "svelte": "^5.36.14",
    "svelte-check": "^4.3.0",
    "svelte-sonner": "^1.0.5",
    "sveltekit-superforms": "^2.27.1",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.8.3",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "npm:rolldown-vite@latest",
    "vitest": "^3.2.4",
    "wrangler": "^4.25.1"
  },
  "resolutions": {
    "vite": "npm:rolldown-vite@latest"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.4",
    "@atlaskit/pragmatic-drag-and-drop-flourish": "^2.0.3",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@libsql/client": "^0.15.10",
    "@sentry/cloudflare": "^9.40.0",
    "@sentry/sveltekit": "^9.40.0",
    "better-auth": "^1.3.3",
    "d3": "^7.9.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "^0.44.3",
    "drizzle-zod": "^0.8.2",
    "runed": "^0.30.0",
    "uqr": "^0.1.2",
    "uuid": "^11.1.0",
    "zod": "^4.0.8"
  },
  "packageManager": "yarn@4.9.2"
}
