{
  "name": "anon-feedback-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "yarn run build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio",
    "deploy": "yarn run build && wrangler deploy",
    "cf-typegen": "wrangler types && mv worker-configuration.d.ts src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.20250429.0",
    "@playwright/test": "^1.49.1",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/adapter-cloudflare": "^7.0.2",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.4",
    "@types/node": "^22",
    "drizzle-kit": "^0.30.2",
    "drizzle-seed": "^0.3.1",
    "jsdom": "^26.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.0.0",
    "vite": "^6.2.6",
    "vitest": "^3.0.0",
    "wrangler": "^4.13.2"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.6.1",
    "@atlaskit/pragmatic-drag-and-drop-flourish": "^2.0.2",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.0.3",
    "@auth/core": "^0.39.0",
    "@auth/sveltekit": "^1.9.1",
    "@libsql/client": "^0.14.0",
    "@tsndr/cloudflare-worker-jwt": "^3.1.4",
    "auth0": "^4.22.0",
    "auth0-js": "^9.28.0",
    "crypto-js": "^4.2.0",
    "drizzle-orm": "^0.40.0",
    "jose": "^6.0.10"
  },
  "packageManager": "yarn@4.9.1+sha512.f95ce356460e05be48d66401c1ae64ef84d163dd689964962c6888a9810865e39097a5e9de748876c2e0bf89b232d583c33982773e9903ae7a76257270986538"
}
