{
  "name": "anon-feedback-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "yarn run build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "yarn tsx --env-file=.env ./db/seed.ts",
    "deploy": "yarn run build && wrangler deploy",
    "cf-typegen": "wrangler types && mv worker-configuration.d.ts src/",
    "auth:schema": "npx @better-auth/cli@latest generate --output src/lib/server/db/auth-schema.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.20250604.0",
    "@floating-ui/core": "^1.7.1",
    "@floating-ui/dom": "^1.7.1",
    "@internationalized/date": "^3.8.1",
    "@lucide/svelte": "^0.511.0",
    "@playwright/test": "^1.52.0",
    "@sveltejs/adapter-auto": "^6.0.1",
    "@sveltejs/adapter-cloudflare": "^7.0.3",
    "@sveltejs/kit": "^2.21.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^22.15.29",
    "bits-ui": "^2.4.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.1",
    "drizzle-seed": "^0.3.1",
    "jsdom": "^26.1.0",
    "svelte": "^5.33.14",
    "svelte-check": "^4.2.1",
    "tailwind-merge": "^3.3.0",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.3.3",
    "typescript": "^5.8.3",
    "unplugin-turbo-console": "^2.1.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.1",
    "wrangler": "^4.19.1"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.2",
    "@atlaskit/pragmatic-drag-and-drop-flourish": "^2.0.3",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
    "@libsql/client": "^0.15.8",
    "better-auth": "^1.2.8",
    "drizzle-orm": "^0.44.1",
    "drizzle-zod": "^0.8.2",
    "uuid": "^11.1.0",
    "zod": "^3.25.50"
  },
  "packageManager": "yarn@4.9.1"
}
